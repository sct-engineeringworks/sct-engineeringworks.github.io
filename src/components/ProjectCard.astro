---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  result: string;
  linkLabel?: string;
  status?: string;
  featured?: boolean;
}
const { eyebrow, title, description, href, result, linkLabel = 'Read case study', status, featured = false } = Astro.props;
---

<article class:list={['project-card', { 'project-card-featured': featured }]}>
  <div class="project-card-top">
    <span class="eyebrow">{eyebrow}</span>
    {status && <span class="status-pill">{status}</span>}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <div class="project-result"><span>OUTCOME</span><strong>{result}</strong></div>
  <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true"> →</span></a>
</article>
