---
interface Props {
  index: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  tags: string[];
}
const { index, title, description, href, linkLabel, tags } = Astro.props;
---

<article class="track-card">
  <span class="card-index">{index}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <ul class="tag-list" aria-label="Capabilities">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="text-link" href={href}>{linkLabel}<span aria-hidden="true"> ↗</span></a>
</article>

