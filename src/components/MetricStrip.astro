---
interface Metric { value: string; label: string }
interface Props { metrics: Metric[] }
const { metrics } = Astro.props;
---

<div class="metric-strip" aria-label="Measured outcomes">
  {metrics.map((metric) => (
    <div class="metric">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </div>
  ))}
</div>

