---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrecisionGraphic from '../components/PrecisionGraphic.astro';
import MetricStrip from '../components/MetricStrip.astro';
import TrackCard from '../components/TrackCard.astro';
import ProjectCard from '../components/ProjectCard.astro';

const metrics = [
  { value: '±5 µm', label: 'Automated optical test-bench accuracy achieved' },
  { value: '< 20 nm', label: 'National reference machine uncertainty delivered' },
  { value: '15%', label: 'Equipment downtime reduction through SPC' },
  { value: '2 sites', label: 'Deployment of a 3D calibration reference' },
];
---

<BaseLayout
  title="SCT Engineering Works | Mechanical Design and Precision Metrology"
  description="SCT designs and validates precision mechanical systems, metrology equipment, special-purpose machines, and automated test systems from Ottawa, Canada."
  alternatePath="/fr/"
>
  <section class="container hero">
    <div class="hero-copy">
      <p class="overline">Ottawa, Canada · French and English</p>
      <h1>Precision systems,<span class="accent">made credible.</span></h1>
      <p class="hero-lede">Mechanical design, precision metrology, and technical project delivery for systems that must be built, measured, verified, and transferred with confidence.</p>
      <div class="button-row">
        <a class="button" href="/projects/">Explore selected work</a>
        <a class="button secondary" href="#capabilities">View capabilities</a>
      </div>
    </div>
    <div class="hero-graphic"><PrecisionGraphic /></div>
  </section>

  <div class="container"><MetricStrip metrics={metrics} /></div>

  <section id="capabilities" class="section container" data-reveal>
    <div class="section-heading">
      <div>
        <span class="section-kicker">Three connected disciplines</span>
        <h2>From geometric intent to verified performance.</h2>
      </div>
      <p>The portfolio is organized around the three ways I create value: designing the system, establishing confidence in its measurements, and coordinating delivery across disciplines.</p>
    </div>
    <div class="track-grid">
      <TrackCard
        index="01"
        title="Precision metrology"
        description="Measurement architectures, calibration strategy, uncertainty-aware design, validation protocols, and data-led process control."
        href="/metrology/"
        linkLabel="Explore metrology"
        tags={['Uncertainty', 'Calibration', 'SPC', 'Traceability']}
      />
      <TrackCard
        index="02"
        title="Mechanical design"
        description="High-precision mechanisms and special-purpose machines developed from requirements through detailed design, prototyping, and production support."
        href="/mechanical-design/"
        linkLabel="Explore design"
        tags={['SolidWorks', 'GD&T', 'DFM/DFA', 'FEA']}
      />
      <TrackCard
        index="03"
        title="Technical project delivery"
        description="Structured execution across mechanics, controls, instrumentation, suppliers, validation, documentation, and handover."
        href="/project-delivery/"
        linkLabel="Explore delivery"
        tags={['Requirements', 'Kanban', 'Risk', 'V&V']}
      />
    </div>
  </section>

  <section class="section light-section" data-reveal>
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="section-kicker">Selected case studies</span>
          <h2>Evidence before adjectives.</h2>
        </div>
        <p>Each case study connects a real engineering constraint to the approach, decisions, deliverables, and measurable result. Confidential implementation details are intentionally excluded.</p>
      </div>
      <div class="project-grid">
        <ProjectCard
          eyebrow="Additive manufacturing · Three-axis study"
          title="Axiomatic design of an AM test artifact"
          description="Requirements-led artifact design connected to physical LPBF manufacture, dimensional metrology, and traceable project delivery."
          href="/projects/axiomatic-am-test-artifact/"
          result="62 reported values"
          featured
        />
        <ProjectCard
          eyebrow="Optical metrology"
          title="Automated optical test bench"
          description="Mechanical design and validation of an automated system for digital defect-detection measurement."
          href="/projects/optical-test-bench/"
          result="±5 µm accuracy"
        />
        <ProjectCard
          eyebrow="Ultra-precision systems"
          title="National reference form metrology"
          description="Cross-functional delivery of an ultra-precision reference machine for circularity and cylindricity measurement."
          href="/projects/national-form-metrology/"
          result="< 20 nm uncertainty"
        />
        <ProjectCard
          eyebrow="Production calibration"
          title="3D optical calibration reference"
          description="A physical reference architecture designed to standardize full-field optical sensor calibration."
          href="/projects/3d-calibration-reference/"
          result="Deployed at 2 sites"
        />
        <ProjectCard
          eyebrow="Robotics and vision"
          title="Robotic vision pick-and-place"
          description="A personal development platform combining collaborative robotics, global-shutter vision, calibration, and object detection."
          href="/projects/robotic-vision-pick-place/"
          result="Calibrated prototype"
          status="In development"
        />
      </div>
    </div>
  </section>

  <section class="section container" data-reveal>
    <div class="section-heading">
      <div>
        <span class="section-kicker">Working method</span>
        <h2>A traceable route from need to acceptance.</h2>
      </div>
      <p>The exact tools change with the system. The underlying discipline does not: define the evidence required, make design decisions explicit, and verify what matters.</p>
    </div>
    <div class="method-grid">
      <div class="method-step"><h3>Frame</h3><p>Translate stakeholder needs into measurable requirements, interfaces, constraints, and acceptance criteria.</p></div>
      <div class="method-step"><h3>Design</h3><p>Develop the mechanical architecture, tolerances, drawings, prototypes, analysis, and risk controls.</p></div>
      <div class="method-step"><h3>Verify</h3><p>Plan tests, calibrate the measurement chain, analyze results, and close gaps against requirements.</p></div>
      <div class="method-step"><h3>Transfer</h3><p>Coordinate build, suppliers, documentation, demonstrations, commissioning, and production handover.</p></div>
    </div>
  </section>

  <section class="section container" data-reveal>
    <div class="section-heading">
      <div>
        <span class="section-kicker">Professional foundation</span>
        <h2>Credentials that support the work.</h2>
      </div>
      <p>Practical design capability is reinforced by formal study, certification, project-delivery training, and international recognition in precision engineering.</p>
    </div>
    <div class="credential-row">
      <div class="credential"><strong>CSWP and Advanced</strong><span>SolidWorks Professional, Drawing Tools, Sheet Metal, and Weldments</span></div>
      <div class="credential"><strong>JAKA Level 1</strong><span>Collaborative robotics programming, setup, and application delivery</span></div>
      <div class="credential"><strong>Project delivery</strong><span>Project Management and Sustainability for Engineers, Toronto Metropolitan University</span></div>
      <div class="credential"><strong>Doctorate</strong><span>Mechanical Engineering, Université Paris-Saclay and ENS Paris-Saclay</span></div>
    </div>
  </section>

  <section class="section container" data-reveal>
    <div class="cta-panel">
      <div>
        <span class="section-kicker">Professional opportunities</span>
        <h2>Building reliable mechanical systems in Canada.</h2>
        <p>Open to mechanical design, precision metrology, validation, special-purpose machine, and technical project opportunities in Ontario, Québec, and across Canada.</p>
      </div>
      <a class="button" href="https://github.com/sct-engineeringworks">View GitHub profile</a>
    </div>
  </section>
</BaseLayout>
