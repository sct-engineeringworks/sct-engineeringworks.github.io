---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
---

<BaseLayout title="Case Studies | SCT Engineering Works" description="Selected non-confidential case studies in precision metrology, mechanical design, automated test systems, and robotic vision." alternatePath="/fr/projets/">
  <header class="container page-hero"><p class="section-kicker">Selected work</p><h1>Engineering case studies</h1><p class="page-lede">A concise record of the problem, role, method, deliverables, and evidence. Employer-owned implementation details are not reproduced.</p></header>
  <section class="section light-section"><div class="container"><div class="project-grid">
    <ProjectCard eyebrow="Additive manufacturing · Three-axis study" title="Axiomatic design of an AM test artifact" description="Requirements-led mechanical design, physical LPBF manufacture, dimensional metrology, and traceable technical delivery." href="/projects/axiomatic-am-test-artifact/" result="62 physical measurement values" featured />
    <ProjectCard eyebrow="Optical metrology" title="Automated optical test bench" description="Mechanical design and validation of an automated measurement system for digital defect detection." href="/projects/optical-test-bench/" result="±5 µm accuracy" />
    <ProjectCard eyebrow="Ultra-precision systems" title="National reference form metrology" description="Architecture and multidisciplinary delivery of a national reference machine for form measurement." href="/projects/national-form-metrology/" result="< 20 nm uncertainty" />
    <ProjectCard eyebrow="Production calibration" title="3D optical calibration reference" description="A reference artefact developed to standardize full-field optical sensor calibration." href="/projects/3d-calibration-reference/" result="2 production sites" />
    <ProjectCard eyebrow="Robotics and vision" title="Robotic vision pick-and-place" description="A personal platform for robot control, eye-to-hand calibration, object detection, and repeatable handling." href="/projects/robotic-vision-pick-place/" result="Calibrated prototype" status="In development" />
  </div></div></section>
  <section class="section container"><p class="disclosure-note"><strong>Disclosure boundary:</strong> the portfolio uses generalized descriptions, independently prepared diagrams, and metrics approved for professional communication. Proprietary CAD, source code, data, drawings, dimensions, images, and internal documents are excluded.</p></section>
</BaseLayout>
